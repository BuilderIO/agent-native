    "oxlint-tsgolint": "0.24.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript-7": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.80.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@10.29.1",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@tanstack/react-query": "5.101.2",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "rollup": ">=4.59.0",
      "multer": ">=2.1.1",
      "minimatch": ">=9.0.7",
      "undici": "^7.28.0",
      "lodash": ">=4.18.0",
