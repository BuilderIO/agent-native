{
  "name": "@agent-native/agentkit",
  "version": "0.198.4",
  "description": "Provider-neutral AgentKit protocol, headless client, and transports for composable agent-native conversations.",
  "homepage": "https://github.com/BuilderIO/agent-native#readme",
  "bugs": {
    "url": "https://github.com/BuilderIO/agent-native/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BuilderIO/agent-native",
    "directory": "packages/agentkit"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./http": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59"
  },
  "devDependencies": {
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  }
}
