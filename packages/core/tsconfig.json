{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Opted out until the existing errors are fixed; guard:compiler-strictness
    // fails new ones on added lines, and these may only be removed.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "react-dom"],
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/core.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/templates",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.harness.ts",
    "src/**/*.e2e-host.tsx",
    "src/**/*.test-d.ts",
    // src/cli and testing.ts (which re-exports CLI symbols for "./testing")
    // build and typecheck through tsconfig.cli.json; including them here too
    // would compile them twice.
    "src/cli/**",
    "src/testing.ts"
  ]
}
