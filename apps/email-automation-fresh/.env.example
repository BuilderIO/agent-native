# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# AUTH_DISABLED=true

# For an account-free loopback preview, create a local ignored .env file and
# set AUTH_DISABLED=1. Never commit or deploy this setting.

# The shared onboarding supports Connect Builder / Add your own keys. For
# local agent work, optionally set ANTHROPIC_API_KEY or OPENAI_API_KEY in the
# ignored .env file, then restart the dev server.
