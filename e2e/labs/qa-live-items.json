[
 {
  "ref": "labs-1578",
  "source": "https://github.com/BuilderIO/agent-native-labs/pull/1578",
  "what": "Content database: a second property named Notes becomes 'Notes 2' and survives reload",
  "target": {
   "app": "content-2",
   "ref": "labs-1578",
   "steps": [
    {
     "ifVisible": "role=dialog[name=\"Set up your workspace\"]",
     "then": [
      {
       "click": "role=button[name=\"Continue\"]"
      },
      {
       "click": "role=radio[name=/For work/]"
      },
      {
       "click": "role=button[name=\"Open workspace\"]"
      }
     ]
    },
    {
     "action": "create-content-page",
     "input": {
      "title": "qa-tmp-collision",
      "kind": "database",
      "databaseSchema": "empty"
     },
     "as": "pg"
    },
    {
     "goto": "/database/${pg.page.id}"
    },
    {
     "click": "[aria-label=\"Add property\"]"
    },
    {
     "fill": "input[aria-label=\"Property name\"]",
     "value": "Notes"
    },
    {
     "press": "Enter"
    },
    {
     "press": "Escape"
    },
    {
     "click": "[aria-label=\"Add property\"]"
    },
    {
     "fill": "input[aria-label=\"Property name\"]",
     "value": "Notes"
    },
    {
     "press": "Enter"
    },
    {
     "expectText": "Notes 2"
    }
   ],
   "verify": [
    {
     "goto": "/database/${pg.page.id}"
    },
    {
     "reload": true
    },
    {
     "expectText": "Notes 2"
    },
    {
     "screenshot": "notes-2"
    }
   ],
   "cleanup": [
    {
     "action": "update-content-page",
     "input": {
      "pageId": "${pg.page.id}",
      "isTrashed": true
     }
    }
   ]
  }
 }
]