# Production auth
# ACCESS_TOKEN=your-secret-token

# Database (defaults to local PGlite at data/pglite)
# DATABASE_URL=postgres://user:password@host/database

# Community app publishing (Builder Publish CMS)
# BUILDER_CMS_PRIVATE_KEY=
# AGENT_NATIVE_COMMUNITY_APP_PUBLISHING_ORG_ID=

# Captcha (optional — Cloudflare Turnstile)
# TURNSTILE_SECRET_KEY=
# VITE_TURNSTILE_SITE_KEY=
