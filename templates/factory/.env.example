# Custom health check message
PING_MESSAGE=pong

# Email stamped as the creator of the deployment-owned observation scheduler.
WORKSPACE_OWNER_EMAIL=

# Optional explicit id of the Dispatch vault organization. Leave blank when
# the deployment owner is a member of the organization where Dispatch synced
# the shared keys. This is an org id, not a secret.
AGENT_VAULT_ORG_ID=

# Use the same stable workspace key as Dispatch and sibling apps so they can
# decrypt shared app_secrets rows. Do not rotate this independently per app.
WORKSPACE_SECRETS_ENCRYPTION_KEY=

# Public URL of this Factory deployment. Keep this aligned with the deployed
# Netlify URL until a custom domain is explicitly approved and configured.
FACTORY_PUBLIC_URL=https://agent-native-factory.netlify.app

# Provider credentials belong in Settings → Integrations or the workspace vault.
# Local sqlite (`pnpm dev`) may also read these from `.env` when no connection
# or vault row exists. Hosted Factory ignores them.
# SLACK_BOT_TOKEN=
# GITHUB_TOKEN=
# Local-only GitHub App fallback during migration. Hosted Factory reads these
# from the shared vault, not deployment environment variables.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=
# SENTRY_AUTH_TOKEN=

# Skip login/signup (local dev / preview only)
# AUTH_DISABLED=true
