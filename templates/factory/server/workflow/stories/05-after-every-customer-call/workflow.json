{
  "nodes": [
    {
      "id": "every30",
      "name": "every30",
      "position": {
        "x": 0,
        "y": 48
      },
      "kind": "trigger",
      "settings": {
        "schedule": {
          "every": "30m"
        }
      }
    },
    {
      "id": "calls",
      "name": "calls",
      "position": {
        "x": 344,
        "y": 48
      },
      "kind": "source",
      "settings": {
        "source": "window",
        "operation": "gong.newCalls",
        "args": {},
        "maxItems": 50
      }
    },
    {
      "id": "external",
      "name": "external",
      "position": {
        "x": 688,
        "y": 20
      },
      "kind": "filter",
      "settings": {
        "combinator": "all",
        "rules": [
          {
            "left": "item.extras.scope",
            "op": "equals",
            "right": "External"
          }
        ]
      }
    },
    {
      "id": "internalOnly",
      "name": "internalOnly",
      "position": {
        "x": 1032,
        "y": 0
      },
      "kind": "end",
      "settings": {
        "outcome": "dismissed",
        "reason": "Internal-only call"
      }
    },
    {
      "id": "transcript",
      "name": "transcript",
      "position": {
        "x": 1032,
        "y": 96
      },
      "kind": "lookup",
      "settings": {
        "operation": "gong.transcript",
        "args": {
          "callId": {
            "mode": "path",
            "path": "item.externalId"
          }
        }
      }
    },
    {
      "id": "extract",
      "name": "extract",
      "position": {
        "x": 1376,
        "y": 96
      },
      "kind": "ai",
      "settings": {
        "instruction": "Summarize the customer call from its transcript: a short summary, the action items, the risks, and the next step. Never copy transcript passages into any field. Use your own words: reuse no more than five consecutive transcript words and no quotation marks.",
        "result": {
          "summary": {
            "type": "string"
          },
          "actionItems": {
            "type": "array",
            "description": "One object per action item with text (what to do), owner (who, as said on the call: a name or email, never an id) and due (when, as said on the call). An empty list when there are none."
          },
          "risks": {
            "type": "array",
            "description": "Short statements of what could stop the customer succeeding. An empty list when there are none."
          },
          "nextStep": {
            "type": "string"
          }
        },
        "mode": "perItem",
        "tools": [],
        "batchSize": 10,
        "inputBudgetTokens": 20000
      }
    },
    {
      "id": "post",
      "name": "post",
      "position": {
        "x": 2064,
        "y": 144
      },
      "kind": "action",
      "settings": {
        "operation": "slack.postMessage",
        "args": {
          "to": {
            "mode": "path",
            "path": "settings.extras.callsChannel"
          },
          "text": {
            "mode": "ai",
            "instruction": "Write a short Slack post from the extracted fields only (nodes.extract): the call title, the summary, the action items, the risks and the next step. Summaries only: never quote or paste anything from the transcript (nodes.transcript)."
          }
        }
      }
    },
    {
      "id": "splitItems",
      "name": "splitItems",
      "position": {
        "x": 1720,
        "y": 48
      },
      "kind": "split",
      "settings": {
        "field": "nodes.extract.actionItems"
      }
    },
    {
      "id": "task",
      "name": "task",
      "position": {
        "x": 2064,
        "y": 48
      },
      "kind": "action",
      "settings": {
        "operation": "hubspot.createTask",
        "args": {
          "title": {
            "mode": "path",
            "path": "item.text"
          },
          "body": {
            "mode": "fixed",
            "value": "Likely owner: {{ item.owner }}. Suggested due date: {{ item.due }}. From the call: {{ nodes.extract.summary }}"
          }
        }
      }
    },
    {
      "id": "done",
      "name": "done",
      "position": {
        "x": 2408,
        "y": 96
      },
      "kind": "end",
      "settings": {
        "outcome": "done"
      }
    }
  ],
