{
  "scenarios": {
    "an-answered-incident-resolves-into-a-postmortem-draft": {
      "description": "The on-call person is paged by Slack and email, answers, the issue stays open for three looks and then resolves, and a postmortem draft is written to Notion and announced with its link.",
      "steps": [
        {
          "kind": "offer",
          "source": "spikes",
          "recording": "oneIssue",
          "calls": 1
        },
        {
          "kind": "offer",
          "source": "spikes",
          "recording": "none"
        },
        {
          "kind": "serve",
          "operation": "slack.postMessage",
          "recording": "posted"
        },
        {
          "kind": "serve",
          "operation": "email.send",
          "recording": "sent"
        },
        {
          "kind": "serve",
          "operation": "sentry.issueEvents",
          "recording": "events"
        },
        {
          "kind": "serve",
          "operation": "notion.createPage",
          "recording": "created"
        },
        {
          "kind": "ai",
          "node": "summarize",
          "recording": "high"
        },
        {
          "kind": "ai",
          "node": "postmortem",
          "recording": "grounded"
        },
        {
          "kind": "serve",
          "operation": "sentry.issueStatus",
          "recording": "unresolved",
          "calls": 2
        },
        {
          "kind": "serve",
          "operation": "sentry.issueStatus",
          "recording": "resolved"
        },
        {
          "kind": "tick",
          "at": "+0m",
          "label": "the spike is paged"
        },
        {
          "kind": "tick",
          "at": "+5m",
          "label": "nothing is due yet"
        },
        {
          "kind": "reply",
          "thread": {
            "channelId": "D0ONCALL",
            "threadTs": "1760001000.000001"
          },
          "at": "+8m",
          "author": "oncall@example.test",
          "text": "Looking now."
        },
        {
          "kind": "tick",
          "at": "+15m",
          "label": "the answer is seen: now waiting for the fix"
        },
        {
          "kind": "tick",
          "at": "+30m",
          "label": "still open"
        },
        {
          "kind": "tick",
          "at": "+45m",
          "label": "still open"
        },
        {
          "kind": "tick",
          "at": "+1h",
          "label": "resolved: the postmortem is written"
        }
      ]
    },
