          "kind": "ai",
          "node": "explain",
          "recording": "causes"
        },
        {
          "kind": "tick",
          "label": "07:00, the daily run"
        },
        {
          "kind": "reply",
          "thread": {
            "channelId": "C0OWNERS",
            "threadTs": "1760001000.000001"
          },
          "at": "+1h",
          "author": "deploy-bot",
          "text": "Deploy finished.",
          "bot": true
        },
        {
          "kind": "tick",
          "label": "the last check before the deadline",
          "at": "+3h45m"
        },
        {
          "kind": "tick",
          "label": "four hours on, still no answer",
          "at": "+4h"
        },
        {
          "kind": "tick",
          "label": "the next check",
          "at": "+4h15m"
        }
      ]
    },
