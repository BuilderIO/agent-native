{
  "scenarios": {
    "a-spike-day-alerts-the-owners-with-suspects-and-a-reply-ends-it": {
      "description": "Two services spike while three others stay under a floor or have no baseline. One alert names both spikes with the pull requests that merged in the last day, the owners are emailed too, the spike waits for a reply, checking every 15 minutes, and an owner's reply ends it with no escalation.",
      "start": "2026-10-19T14:00:00.000Z",
      "steps": [
        {
          "kind": "serve",
          "operation": "bigquery.billingQuery",
          "recording": "spikeDay",
          "calls": 1
        },
        {
          "kind": "serve",
          "operation": "bigquery.billingQuery",
          "recording": "quietDay"
        },
        {
          "kind": "serve",
          "operation": "github.mergedPullRequests",
          "recording": "recent"
        },
        {
          "kind": "serve",
          "operation": "slack.postMessage",
          "recording": "posted"
        },
        {
          "kind": "serve",
          "operation": "email.send",
          "recording": "sent"
        },
        {
          "kind": "ai",
          "node": "explain",
          "recording": "causes"
        },
        {
          "kind": "tick",
          "label": "07:00, the daily run"
        },
        {
          "kind": "tick",
          "label": "15 minutes on, nobody has answered",
          "at": "+15m"
        },
        {
          "kind": "reply",
          "thread": {
            "channelId": "C0OWNERS",
            "threadTs": "1760001000.000001"
          },
          "at": "+40m",
          "author": "owner@example.test",
          "text": "Known: the export backfill. Scaled on purpose."
        },
        {
          "kind": "tick",
          "label": "an owner has replied",
          "at": "+45m"
        }
      ]
    },
    "silence-for-four-hours-escalates-once-and-a-bot-does-not-count": {
      "description": "Nobody answers for four hours (a bot's message does not count as an answer): the first tick at or after the deadline posts one escalation message and finishes the spike; later ticks do nothing.",
      "start": "2026-10-19T14:00:00.000Z",
      "steps": [
        {
          "kind": "serve",
          "operation": "bigquery.billingQuery",
          "recording": "spikeDay",
          "calls": 1
        },
        {
          "kind": "serve",
