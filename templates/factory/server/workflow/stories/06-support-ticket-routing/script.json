    "a-ticket-whose-classification-cannot-be-read-fails-alone": {
      "description": "One ticket's classification comes back unreadable: that ticket fails with a typed error and nothing is sent for it, while the other ticket in the run is handled. The provider has moved its cursor on, so the next run does not offer the failed ticket again.",
      "steps": [
        {
          "kind": "serve",
          "operation": "pylon.newTickets",
          "recording": "bugAndOther",
          "calls": 1
        },
        {
          "kind": "serve",
          "operation": "pylon.newTickets",
          "recording": "none"
        },
        {
          "kind": "serve",
          "operation": "pylon.ticketThread",
          "recording": "threads"
        },
        {
          "kind": "serve",
          "operation": "stripe.customerBilling",
          "recording": "customers"
        },
        {
          "kind": "serve",
          "operation": "jira.createIssue",
          "recording": "created"
        },
        {
          "kind": "serve",
          "operation": "pylon.addNote",
          "recording": "added"
        },
        {
          "kind": "serve",
          "operation": "pylon.reply",
          "recording": "replied"
        },
        {
          "kind": "serve",
          "operation": "slack.postMessage",
          "recording": "posted"
        },
        {
          "kind": "serve",
          "operation": "email.send",
          "recording": "sent"
        },
        {
          "kind": "ai",
          "node": "classify",
          "recording": "bugAndUnreadable"
        },
        {
          "kind": "ai",
          "node": "jira",
          "recording": "bug"
        },
        {
          "kind": "tick",
          "label": "the run that fails one ticket"
        },
        {
          "kind": "tick",
          "at": "+10m",
          "label": "the next run"
        }
      ]
    },
    "an-unreadable-ticket-that-is-offered-again-is-handed-to-a-person-on-the-third-try": {
      "description": "When the provider does offer the ticket again, each unreadable classification spends an attempt and the third hands the ticket to a person, with nothing sent to the customer.",
