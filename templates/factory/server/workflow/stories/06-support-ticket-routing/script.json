{
  "scenarios": {
    "each-category-lands-where-the-story-says": {
      "description": "Five tickets in one run: a bug becomes a Jira issue, a note and a reply; a supported billing answer goes to its customer while an unsure one goes to finance as a draft; an urgent ticket goes to the support lead by Slack and email and gets no reply; anything else gets an internal note with a suggested reply.",
      "steps": [
        {
          "kind": "serve",
          "operation": "pylon.newTickets",
          "recording": "all"
        },
        {
          "kind": "serve",
          "operation": "pylon.ticketThread",
          "recording": "threads"
        },
        {
          "kind": "serve",
          "operation": "stripe.customerBilling",
          "recording": "customers"
        },
        {
          "kind": "serve",
          "operation": "jira.createIssue",
          "recording": "created"
        },
        {
          "kind": "serve",
          "operation": "pylon.addNote",
          "recording": "added"
        },
        {
          "kind": "serve",
          "operation": "pylon.reply",
          "recording": "replied"
        },
        {
          "kind": "serve",
          "operation": "slack.postMessage",
          "recording": "posted"
        },
        {
          "kind": "serve",
          "operation": "email.send",
          "recording": "sent"
        },
        {
          "kind": "ai",
          "node": "classify",
          "recording": "all"
        },
        {
          "kind": "ai",
          "node": "jira",
          "recording": "bug"
        },
        {
          "kind": "ai",
          "node": "answer",
          "recording": "mixed"
        },
        {
          "kind": "ai",
          "node": "suggest",
          "recording": "reply"
        },
        {
          "kind": "tick",
          "label": "the 10-minute run"
        }
      ]
    },
    "a-model-claiming-support-for-an-invented-fact-is-believed": {
      "description": "What no code checks: the model says its answer is supported and sure although the refund it states is not in the Stripe data, and it states it without an amount or a date. The model's own flags are the only guard left, so this answer is sent to the customer. Kept as a scenario so the gap stays visible.",
      "steps": [
        {
          "kind": "serve",
          "operation": "pylon.newTickets",
          "recording": "claimed"
        },
        {
          "kind": "serve",
          "operation": "pylon.ticketThread",
          "recording": "threads"
        },
        {
          "kind": "serve",
          "operation": "stripe.customerBilling",
          "recording": "customers"
        },
        {
          "kind": "serve",
          "operation": "jira.createIssue",
          "recording": "created"
        },
        {
          "kind": "serve",
          "operation": "pylon.addNote",
          "recording": "added"
        },
        {
          "kind": "serve",
          "operation": "pylon.reply",
          "recording": "replied"
        },
        {
          "kind": "serve",
          "operation": "slack.postMessage",
          "recording": "posted"
        },
        {
          "kind": "serve",
          "operation": "email.send",
          "recording": "sent"
        },
        {
          "kind": "ai",
          "node": "classify",
          "recording": "claimed"
        },
        {
          "kind": "ai",
          "node": "answer",
          "recording": "inventedFact"
        },
        {
          "kind": "tick",
          "label": "the 10-minute run"
        }
      ]
    },
