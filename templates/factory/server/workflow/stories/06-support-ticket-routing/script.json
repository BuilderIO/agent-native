    "a-test-of-the-classify-node-runs-on-a-sample-ticket-and-sends-nothing": {
      "description": "The test step runs only the classify node on a pinned sample ticket: the model is asked once, and no ticket is read and nothing is sent.",
      "steps": [
        {
          "kind": "ai",
          "node": "classify",
          "recording": "sample"
        },
        {
          "kind": "tick",
          "mode": "test",
          "node": "classify",
          "label": "test classify",
          "sample": [
            {
              "id": "t-sample",
              "item": {
                "title": "Sample ticket about an invoice",
                "author": "sample@customer.example.test",
                "thread": {
                  "ticketId": "t-sample"
                }
              },
              "nodes": {
                "thread": {
                  "data": [
                    {
                      "id": "msg-t-sample"
                    }
                  ]
                }
              }
            }
          ]
        }
