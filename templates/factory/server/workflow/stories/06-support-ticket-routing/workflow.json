    },
    {
      "id": "finance",
      "name": "finance",
      "position": {
        "x": 3096,
        "y": 96
      },
      "kind": "action",
      "settings": {
        "operation": "slack.postMessage",
        "args": {
          "to": {
            "mode": "path",
