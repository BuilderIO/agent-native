      "kind": "action",
      "settings": {
        "operation": "email.send",
        "args": {
          "to": {
            "mode": "path",
            "path": "settings.extras.supportLeadEmail"
          },
          "subject": {
            "mode": "fixed",
            "value": "Urgent ticket: {{ item.title }}"
          },
          "body": {
            "mode": "fixed",
            "value": "{{ nodes.classify.summary }}"
          }
        }
      }
    },
    {
      "id": "suggest",
      "name": "suggest",
      "position": {
        "x": 3096,
        "y": 278
      },
      "kind": "action",
      "settings": {
        "operation": "pylon.addNote",
        "args": {
          "ticketId": {
            "mode": "path",
            "path": "item.externalId"
          },
          "bodyHtml": {
            "mode": "ai",
            "instruction": "Write a suggested reply to the customer as an internal note, in simple HTML. Never promise a refund, a credit or a timeline."
          }
        }
      }
    },
    {
      "id": "done",
