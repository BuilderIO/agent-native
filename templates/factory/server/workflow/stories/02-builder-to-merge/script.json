{
  "scenarios": {
    "a-working-task-is-checked-once-for-its-reports-and-left-alone": {
      "description": "Two reports of one task are checked with one call to Builder, and while Builder is working nothing is sent and nothing changes.",
      "steps": [
        {
          "kind": "serve",
          "operation": "slack.replyInThread",
          "recording": "posted"
        },
        {
          "kind": "serve",
          "operation": "slack.postMessage",
          "recording": "posted"
        },
        {
          "kind": "serve",
          "operation": "builder.followUp",
          "recording": "accepted"
        },
        {
          "kind": "serve",
          "operation": "factory.mergeGate",
          "recording": "eligible"
        },
        {
          "kind": "serve",
          "operation": "github.mergePullRequest",
          "recording": "merged"
        },
        {
          "kind": "serve",
          "operation": "builder.check",
          "recording": "working"
        },
        {
          "kind": "offer",
          "source": "inFlight",
          "recording": "twoReports"
        },
        {
          "kind": "tick",
          "label": "working",
          "at": "+0m"
        },
        {
          "kind": "tick",
          "label": "still working",
          "at": "+5m"
        }
      ]
    },
    "a-stuck-task-is-nudged-twice-then-escalated": {
      "description": "A stuck task is nudged on two ticks, and on the third the triage owner is told and both reports go to a person; a fourth tick does nothing more.",
      "steps": [
        {
          "kind": "serve",
          "operation": "slack.replyInThread",
          "recording": "posted"
        },
        {
          "kind": "serve",
          "operation": "slack.postMessage",
          "recording": "posted"
        },
        {
          "kind": "serve",
          "operation": "builder.followUp",
          "recording": "accepted"
        },
        {
          "kind": "serve",
          "operation": "factory.mergeGate",
          "recording": "eligible"
        },
        {
          "kind": "serve",
          "operation": "github.mergePullRequest",
          "recording": "merged"
        },
        {
          "kind": "serve",
          "operation": "builder.check",
          "recording": "stuck"
        },
        {
          "kind": "offer",
          "source": "inFlight",
          "recording": "twoReports"
        },
        {
          "kind": "tick",
          "label": "stuck: first nudge",
          "at": "+0m"
        },
        {
          "kind": "tick",
          "label": "stuck: second nudge",
          "at": "+5m"
        },
        {
          "kind": "tick",
          "label": "stuck: escalated",
          "at": "+10m"
        },
        {
          "kind": "offer",
          "source": "inFlight",
          "recording": "none"
        },
        {
          "kind": "tick",
          "label": "nothing more happens",
          "at": "+15m"
        }
      ]
    },
    "a-failing-pull-request-is-sent-back-once-per-head-commit": {
      "description": "A failing pull request gets one follow-up per head commit, and none while Builder is working, even when its checks fail.",
      "steps": [
        {
          "kind": "serve",
          "operation": "slack.replyInThread",
          "recording": "posted"
        },
        {
          "kind": "serve",
          "operation": "slack.postMessage",
          "recording": "posted"
        },
        {
          "kind": "serve",
          "operation": "builder.followUp",
          "recording": "accepted"
        },
        {
          "kind": "serve",
          "operation": "factory.mergeGate",
          "recording": "eligible"
        },
        {
          "kind": "serve",
          "operation": "github.mergePullRequest",
          "recording": "merged"
        },
        {
          "kind": "offer",
          "source": "inFlight",
          "recording": "twoReports"
        },
        {
          "kind": "serve",
          "operation": "builder.check",
          "recording": "prOpen",
          "calls": 2
        },
        {
          "kind": "serve",
          "operation": "builder.check",
          "recording": "workingWithPr",
          "calls": 1
        },
        {
          "kind": "serve",
          "operation": "builder.check",
          "recording": "prOpen",
          "calls": 2
        },
        {
          "kind": "serve",
          "operation": "github.readPullRequest",
          "recording": "failingA",
          "calls": 2
        },
        {
          "kind": "serve",
          "operation": "github.readPullRequest",
          "recording": "failingB"
        },
        {
          "kind": "ai",
          "node": "fix",
          "recording": "headA",
          "calls": 1
        },
        {
          "kind": "ai",
          "node": "fix",
          "recording": "headB"
        },
        {
          "kind": "tick",
          "label": "head A fails: sent back",
          "at": "+0m"
        },
        {
          "kind": "tick",
          "label": "head A still fails: not sent again",
          "at": "+5m"
        },
        {
          "kind": "tick",
          "label": "head B fails while Builder is working: not sent",
          "at": "+10m"
        },
        {
          "kind": "tick",
          "label": "head B fails, Builder idle: sent back",
          "at": "+15m"
        },
        {
          "kind": "tick",
          "label": "head B still fails: not sent again",
          "at": "+20m"
        }
      ]
    },
