{
  "nodes": [
    {
      "id": "every5",
      "name": "every5",
      "position": {
        "x": 0,
        "y": 135
      },
      "kind": "trigger",
      "settings": {
        "schedule": {
          "every": "5m"
        }
      }
    },
    {
      "id": "inFlight",
      "name": "inFlight",
      "position": {
        "x": 344,
        "y": 135
      },
      "kind": "source",
      "settings": {
        "source": "status",
        "status": "automation_started",
        "takeLimit": 50
      }
    },
    {
      "id": "byTask",
      "name": "byTask",
      "position": {
        "x": 688,
        "y": 135
      },
      "kind": "combine",
      "settings": {
        "mode": "groupBy",
        "key": "item.extras.builderTaskId"
      }
    },
    {
      "id": "check",
      "name": "check",
      "position": {
        "x": 1032,
        "y": 135
      },
      "kind": "agent",
      "settings": {
        "agent": "builder",
        "op": "check",
        "args": {
          "projectId": {
            "mode": "path",
            "path": "item.extras.projectId"
          },
          "branchName": {
            "mode": "path",
            "path": "item.extras.branchName"
          }
        }
      }
    },
    {
      "id": "state",
      "name": "state",
      "position": {
        "x": 1376,
        "y": 83
      },
      "kind": "switch",
      "settings": {
        "routes": [
          {
            "id": "hasPr",
            "label": "Pull request exists",
            "combinator": "all",
            "rules": [
              {
                "left": "nodes.check.hasPullRequest",
                "op": "isTrue"
              }
            ]
          },
          {
            "id": "stuck",
            "label": "Stuck",
            "combinator": "all",
            "rules": [
              {
                "left": "nodes.check.state",
                "op": "equals",
                "right": "stuck"
              }
            ]
          },
          {
            "id": "ended",
            "label": "Ended with no pull request",
            "combinator": "any",
            "rules": [
              {
                "left": "nodes.check.state",
                "op": "equals",
                "right": "failed"
              },
              {
                "left": "nodes.check.state",
                "op": "equals",
                "right": "completed"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "keep",
      "name": "keep",
      "position": {
        "x": 4472,
        "y": 532
      },
      "kind": "end",
      "settings": {
        "outcome": "released"
      }
    },
    {
      "id": "nudgedTwice",
      "name": "nudgedTwice",
      "position": {
        "x": 2752,
        "y": 150
      },
      "kind": "filter",
      "settings": {
        "combinator": "all",
        "rules": [
          {
            "left": "item.nudges",
            "op": "gt",
            "right": 1
          }
        ]
      }
    },
    {
      "id": "alert",
      "name": "alert",
      "position": {
        "x": 3096,
        "y": 240
      },
      "kind": "action",
      "settings": {
        "operation": "slack.postMessage",
        "args": {
          "to": {
            "mode": "path",
            "path": "settings.triageOwnerEmail"
          },
          "text": {
            "mode": "fixed",
            "value": "Builder is stuck on {{ item.title }}"
          }
        }
      }
    },
    {
      "id": "manual",
      "name": "manual",
      "position": {
        "x": 3440,
        "y": 274
      },
      "kind": "end",
      "settings": {
        "outcome": "needsManual"
      }
    },
    {
      "id": "nudge",
      "name": "nudge",
      "position": {
        "x": 3096,
        "y": 144
      },
      "kind": "agent",
      "settings": {
        "agent": "builder",
        "op": "followUp",
        "args": {
          "projectId": {
            "mode": "path",
            "path": "item.extras.projectId"
          },
          "branchName": {
            "mode": "path",
            "path": "item.extras.branchName"
          },
          "userMessage": {
            "mode": "fixed",
            "value": "status? continue"
          }
        }
      }
    },
    {
      "id": "readPr",
      "name": "readPr",
      "position": {
        "x": 1720,
        "y": 911
      },
      "kind": "lookup",
      "settings": {
        "operation": "github.readPullRequest",
        "args": {
          "repo": {
            "mode": "path",
            "path": "item.extras.repository"
          },
          "number": {
            "mode": "path",
            "path": "nodes.check.prNumber"
          }
        }
      }
    },
    {
      "id": "ci",
      "name": "ci",
      "position": {
        "x": 2064,
        "y": 835
      },
      "kind": "switch",
      "settings": {
        "routes": [
          {
            "id": "merged",
            "label": "Merged by someone else",
            "combinator": "all",
            "rules": [
              {
                "left": "nodes.readPr.state",
                "op": "equals",
                "right": "merged"
              }
            ]
          },
          {
            "id": "closed",
            "label": "Closed unmerged",
            "combinator": "all",
            "rules": [
              {
                "left": "nodes.readPr.state",
                "op": "equals",
                "right": "closed"
              }
            ]
          },
          {
            "id": "pending",
            "label": "Pending checks",
            "combinator": "all",
            "rules": [
              {
                "left": "nodes.readPr.checks.pending",
                "op": "gt",
                "right": 0
              }
            ]
          },
          {
            "id": "failing",
            "label": "Failing checks",
            "combinator": "all",
            "rules": [
              {
                "left": "nodes.readPr.checks.failed",
                "op": "gt",
                "right": 0
              }
            ]
          },
          {
            "id": "green",
            "label": "Green",
            "combinator": "all",
            "rules": [
              {
                "left": "nodes.readPr.checks.allPassing",
                "op": "isTrue"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "fix",
      "name": "fix",
      "position": {
        "x": 3440,
        "y": 623
      },
      "kind": "agent",
      "settings": {
        "agent": "builder",
        "op": "followUp",
        "args": {
          "projectId": {
            "mode": "path",
            "path": "item.extras.projectId"
          },
          "branchName": {
            "mode": "path",
            "path": "item.extras.branchName"
          },
          "userMessage": {
            "mode": "ai",
            "instruction": "Ask Builder to fix the failing checks on this pull request. Name each failing check (from readPr.checks.notPassing) and the head commit they ran on (readPr.headSha)."
          }
        }
      }
    },
