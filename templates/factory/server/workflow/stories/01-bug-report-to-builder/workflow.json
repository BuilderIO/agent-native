    {
      "id": "group",
      "name": "group",
      "position": {
        "x": 1344,
        "y": 96
      },
      "kind": "ai",
      "settings": {
        "instruction": "Group related bugs. You are given this run's clear bug reports, each with its own assessment. Answer once for every report, using its id exactly as given, and nothing else about it: its title, thread, author and text are already known and are not yours to repeat. Reports are related when they describe the same defect or the same root cause (the same feature, screen or error text, in the same repository). Give related reports the same groupName, at most 5 to a group, and every other report a groupName of its own. A groupName is only a label that tells the groups apart; the workflow names the group itself. For the Builder gate, give every report in a group the strictest values of its group, copied from each report's own assessment without judging them again: clearBug (true only when every report in the group is), risk (the highest), confidence (the lowest), productUxImplications (true if any), alreadyClaimed (true if any), categories (all of theirs). In reason, say in one sentence why the report joined its group.",
        "result": {
          "groupName": {
            "type": "string",
            "description": "A short label shared by every report of the same defect or root cause, and different for every other group. Only a label: it is never used as an id."
          },
          "clearBug": {
            "type": "boolean",
            "description": "True only when every report in the group describes behavior that is wrong and the correct behavior is evident."
          },
          "risk": {
            "type": "enum",
            "enum": ["low", "medium", "high"],
            "description": "The highest risk of any report in the group: low means a contained change with no data, auth, money or migration."
          },
          "confidence": {
            "type": "enum",
            "enum": ["low", "medium", "high"],
            "description": "The lowest confidence of any report in the group: high only when the report names the cause or the expected behavior and the repository would confirm it."
          },
          "productUxImplications": {
            "type": "boolean",
            "description": "True when any report in the group needs a product or design decision; false when the expected behavior is clear and the fix restores it."
          },
          "alreadyClaimed": {
            "type": "boolean",
            "description": "True when a person already reacted to any report in the group, so it is theirs."
          },
          "categories": {
            "type": "array",
            "description": "Which of these the fix would touch, for every report in the group: auth, session, identity, credentials, vault, migration, payments, security, publishable_package. Use only these words; an empty list when none applies."
          },
          "reason": {
            "type": "string",
            "description": "One sentence on why the report joined its group."
          }
        },
        "mode": "perItem",
        "tools": [],
        "batchSize": 10
      }
    },
    {
      "id": "startBuilder",
      "name": "startBuilder",
      "position": {
        "x": 1792,
        "y": 96
      },
      "kind": "agent",
      "settings": {
        "agent": "builder",
        "op": "start",
        "args": {
          "projectId": {
            "mode": "path",
            "path": "settings.builderProjectId"
          },
          "branchName": {
            "mode": "fixed",
            "value": "factory-{{ item.key }}"
          },
          "userEmail": {
            "mode": "path",
            "path": "item.author"
          },
          "prompt": {
            "mode": "ai",
            "instruction": "Write the task for Builder from the report and its thread: what is broken and where, the steps to reproduce it, and what working looks like. Ask Builder for a regression test that fails before the fix and passes after it, or to say in the pull request why the code cannot be tested. Ask it to prove the fix under a `### Verified` heading in the pull request description. If a user can see the bug in the app, that means running the app, reproducing the bug, and adding before and after screenshots or a recording. If nobody can see it, name the test or command that proves the fix. Use the heading `### Verified` exactly."
          },
          "clearBug": {
            "mode": "path",
            "path": "nodes.group.clearBug"
          },
          "productUxImplications": {
            "mode": "path",
            "path": "nodes.group.productUxImplications"
          },
          "risk": {
            "mode": "path",
            "path": "nodes.group.risk"
          },
          "confidence": {
            "mode": "path",
            "path": "nodes.group.confidence"
          },
          "alreadyClaimed": {
            "mode": "path",
            "path": "nodes.group.alreadyClaimed"
          },
          "categories": {
            "mode": "path",
            "path": "nodes.group.categories"
          }
        }
      }
    },
