    },
    {
      "id": "assess",
      "name": "assess",
      "position": {
        "x": 672,
        "y": 341
      },
      "kind": "ai",
      "settings": {
        "instruction": "Assess whether this report is a clear bug, reading the whole thread. A clear bug describes behavior that is wrong where the correct behavior is evident; a feature request, a question, an opinion or a vague complaint is not one. A report being about the UI or its wording does not make it a product or design question: when the expected behavior is already clear and the fix restores it, it is an ordinary bug. When you cannot tell what is wrong or what correct looks like, say there is not enough context and ask one short question. When you are unsure of one of the other answers, give the cautious one: productUxImplications true, risk higher, confidence lower. Never answer clearBug false because you are unsure: unsure means not enough context, so ask the question. In reason, say in one sentence what in the report decided it.",
        "result": {
          "clearBug": {
            "type": "boolean",
            "description": "True only when the report describes behavior that is wrong and the correct behavior is evident; false for a feature request, a question or an opinion."
          },
          "enoughContext": {
            "type": "boolean",
            "description": "True when the report says what is wrong and what correct looks like well enough to act on; false when the reporter has to be asked first."
          },
          "question": {
            "type": "string",
            "optional": true
          },
          "risk": {
            "type": "enum",
            "enum": ["low", "medium", "high"],
            "description": "Low means a contained change with no data, auth, money or migration, judged from what the fix would touch and not from the reporter's own claim; medium or high otherwise."
          },
          "confidence": {
            "type": "enum",
            "enum": ["low", "medium", "high"],
            "description": "High only when the report names the cause or the expected behavior and the repository would confirm it; medium or low otherwise."
          },
          "productUxImplications": {
            "type": "boolean",
            "description": "True only when fixing it needs a product or design decision (new or changed behavior, a choice between designs, wording that needs sign-off beyond restoring intended behavior); false when the expected behavior is already clear and the fix restores it, including a UI or copy bug whose correct state is evident, because a report being about the UI is not a product question."
          },
          "alreadyClaimed": {
            "type": "boolean",
            "description": "True when a person already reacted to the report, so it is theirs."
          },
          "categories": {
            "type": "array",
            "description": "Which of these the fix would touch: auth, session, identity, credentials, vault, migration, payments, security, publishable_package. Use only these words; an empty list when none applies."
          },
          "reason": {
            "type": "string"
          }
        },
        "mode": "perItem",
        "tools": [],
        "batchSize": 10
      }
    },
    {
      "id": "route",
      "name": "route",
      "position": {
        "x": 896,
        "y": 293
      },
      "kind": "switch",
      "settings": {
        "routes": [
          {
            "id": "claimed",
            "label": "Already claimed by a person",
            "combinator": "all",
            "rules": [
              {
                "left": "nodes.assess.alreadyClaimed",
                "op": "isTrue"
              }
            ]
          },
          {
            "id": "needsInfo",
            "label": "Needs info",
            "combinator": "all",
            "rules": [
              {
                "left": "nodes.assess.enoughContext",
                "op": "equals",
                "right": false
              }
            ]
          },
          {
            "id": "notBug",
            "label": "Not a bug",
            "combinator": "all",
            "rules": [
              {
                "left": "nodes.assess.clearBug",
                "op": "equals",
                "right": false
              }
            ]
          },
          {
            "id": "clear",
            "label": "Clear and safe",
            "combinator": "all",
            "rules": [
              {
                "left": "nodes.assess.clearBug",
                "op": "isTrue"
              },
              {
                "left": "nodes.assess.risk",
                "op": "equals",
                "right": "low"
              },
              {
                "left": "nodes.assess.confidence",
                "op": "equals",
                "right": "high"
              },
              {
                "left": "nodes.assess.productUxImplications",
                "op": "equals",
                "right": false
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ask",
      "name": "ask",
      "position": {
        "x": 1120,
        "y": 516
      },
      "kind": "action",
      "settings": {
        "operation": "slack.replyInThread",
        "args": {
          "channel": {
            "mode": "path",
            "path": "item.thread.channelId"
          },
          "threadTs": {
            "mode": "path",
            "path": "item.thread.threadTs"
          },
          "text": {
            "mode": "ai",
            "instruction": "Ask one short question that unblocks the report."
          }
        }
      }
    },
