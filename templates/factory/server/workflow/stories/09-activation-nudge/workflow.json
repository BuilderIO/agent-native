{
  "nodes": [
    {
      "id": "hourly",
      "name": "hourly",
      "position": {
        "x": 0,
        "y": 48
      },
      "kind": "trigger",
      "settings": {
        "schedule": {
          "every": "60m"
        }
      }
    },
    {
      "id": "subs",
      "name": "subs",
      "position": {
        "x": 344,
        "y": 48
      },
      "kind": "source",
      "settings": {
        "source": "provider-query",
        "operation": "stripe.newSubscriptions",
        "args": {},
        "memory": "inbox",
        "maxItems": 50
      }
    },
    {
      "id": "pause",
      "name": "pause",
      "position": {
        "x": 688,
        "y": 32
      },
      "kind": "wait",
      "settings": {
        "wait": "time",
        "duration": {
          "amount": 3,
          "unit": "days"
        }
      }
    },
    {
      "id": "usage",
      "name": "usage",
      "position": {
        "x": 1032,
        "y": 48
      },
      "kind": "lookup",
      "settings": {
        "operation": "posthog.usage",
        "args": {
          "customerId": {
            "mode": "path",
            "path": "item.extras.customerId"
          },
          "days": {
            "mode": "fixed",
            "value": 3
          }
        }
      }
    },
    {
      "id": "inactive",
      "name": "inactive",
      "position": {
        "x": 1376,
        "y": 20
      },
      "kind": "filter",
      "settings": {
        "combinator": "all",
        "rules": [
          {
            "left": "nodes.usage.results[0][0]",
            "op": "lt",
            "right": "{{ settings.extras.minKeyEvents }}"
          }
        ]
      }
    },
    {
      "id": "mail",
      "name": "mail",
      "position": {
        "x": 1720,
        "y": 96
      },
      "kind": "action",
      "settings": {
        "operation": "email.send",
        "args": {
          "to": {
            "mode": "path",
            "path": "item.extras.customerEmail"
          },
          "subject": {
            "mode": "fixed",
            "value": "Getting started with {{ item.title }}"
          },
          "body": {
            "mode": "ai",
            "instruction": "Write a short, friendly nudge: greet them by the name in their email, suggest the one first thing to try, and link the docs. Do not mention pricing, discounts or their plan."
          }
        }
      }
    },
    {
      "id": "tellOwner",
      "name": "tellOwner",
      "position": {
        "x": 2064,
        "y": 96
      },
      "kind": "action",
      "settings": {
        "operation": "slack.postMessage",
        "args": {
          "to": {
            "mode": "path",
            "path": "settings.extras.accountOwnerEmail"
          },
          "text": {
            "mode": "fixed",
            "value": "Sent an activation nudge to {{ item.title }}."
          }
        }
      }
    },
    {
      "id": "done",
      "name": "done",
      "position": {
        "x": 2408,
        "y": 96
      },
      "kind": "end",
      "settings": {
        "outcome": "done"
      }
    },
    {
      "id": "activated",
      "name": "activated",
      "position": {
        "x": 1720,
        "y": 0
      },
      "kind": "end",
      "settings": {
        "outcome": "dismissed",
        "reason": "activated"
      }
    }
  ],
