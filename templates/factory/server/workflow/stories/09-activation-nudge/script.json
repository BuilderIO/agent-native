{
  "scenarios": {
    "an-inactive-customer-is-nudged-exactly-three-days-later": {
      "description": "Enabling primes the Stripe cursor and takes nothing; the next hour a customer subscribes and parks for three days; an hour before the deadline nothing happens; at three days the usage is read, one email goes to the customer and one Slack message to the account owner, and the saved cursor was handed back on every read.",
      "steps": [
        {
          "kind": "serve",
          "operation": "stripe.newSubscriptions",
          "recording": "primed",
          "calls": 1
        },
        {
          "kind": "serve",
          "operation": "stripe.newSubscriptions",
          "recording": "afterPriming",
          "calls": 1
        },
        {
          "kind": "serve",
          "operation": "stripe.newSubscriptions",
          "recording": "afterNadia"
        },
        {
          "kind": "serve",
          "operation": "posthog.usage",
          "recording": "inactive"
        },
        {
          "kind": "serve",
          "operation": "email.send",
          "recording": "sent"
        },
        {
          "kind": "serve",
          "operation": "slack.postMessage",
          "recording": "posted"
        },
        {
          "kind": "ai",
          "node": "mail",
          "recording": "nudge"
        },
        {
          "kind": "tick",
          "label": "the first run primes the cursor and takes nothing"
        },
        {
          "kind": "tick",
          "label": "the customer subscribes",
          "at": "+1h"
        },
        {
          "kind": "tick",
          "label": "an hour before the three days are up",
          "at": "+3d"
        },
        {
          "kind": "tick",
          "label": "three days after subscribing",
          "at": "+3d1h"
        },
        {
          "kind": "tick",
          "label": "the hour after the nudge",
          "at": "+3d2h"
        }
      ]
    },
    "the-wait-is-exactly-three-days": {
      "description": "One minute before the deadline the customer is still parked, due at exactly three days after the subscription was taken, and nothing has been read from PostHog.",
      "steps": [
