{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["chrome", "vite/client"],
    "rootDirs": ["."],
    "noEmit": true
  },
  "include": ["src/**/*", "scripts/**/*", "vite.config.ts"]
}
