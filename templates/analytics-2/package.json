{
  "name": "analytics-2",
  "private": true,
  "description": "Business analytics dashboards: metrics, charts, and reports over connected data sources.",
  "type": "module",
  "scripts": {
    "predev": "pnpm formatter:assets:ensure",
    "dev": "agent-native dev --inspect",
    "build": "tsx server/formatter/build-assets.ts && tsx server/formatter/build-notebook-assets.ts && agent-native build && tsx server/formatter/copy-assets-to-build.ts",
    "start": "agent-native start",
    "typecheck": "agent-native typecheck",
    "test": "vitest --run",
    "agent-native:doctor": "agent-native doctor",
    "action": "agent-native action",
    "script": "agent-native script",
    "migrate:production": "tsx scripts/migrate-production.ts",
    "skills:update": "agent-native skills update scaffold --project",
    "upgrade:agent-native": "agent-native upgrade",
    "formatter:assets": "tsx server/formatter/build-assets.ts",
    "formatter:assets:ensure": "tsx server/formatter/ensure-assets.ts",
    "kernel:offline-assets": "pnpm formatter:assets:ensure && tsx server/formatter/build-notebook-assets.ts",
    "test:formatter": "pnpm formatter:assets:ensure && pnpm exec vitest --run server/formatter",
    "e2e:daily": "tsx e2e/daily/postgres.ts"
  },
  "dependencies": {
    "@agent-native/core": "workspace:*",
    "@agent-native/toolkit": "workspace:*",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-sql": "6.10.0",
    "@electric-sql/pglite": "0.5.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@google-cloud/bigquery-storage": "6.3.0",
    "@replit/codemirror-vim": "6.4.0",
    "@tabler/icons-react": "catalog:",
    "@tanstack/react-query": "5.104.4",
    "@uiw/react-codemirror": "4.25.12",
    "apache-arrow": "21.2.0",
    "drizzle-orm": "^0.45.4",
    "h3": "2.0.8",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "pyodide": "314.0.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "8.1.0",
    "sonner": "^2.0.8",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0",
    "xlsx": "^0.18.5",
    "yaml": "2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@react-router/dev": "8.1.0",
    "@react-router/fs-routes": "8.1.0",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "24.13.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "8.18.2",
    "fast-check": "^4.10.2",
    "oxfmt": "catalog:",
    "postgres": "^3.4.9",
    "tailwindcss": "catalog:",
    "tsx": "^4.23.15",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "8.23.0"
  },
  "packageManager": "pnpm@10.29.1"
}
