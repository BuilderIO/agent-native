# Cloud database (optional locally - content works file-only by default)
# Production/shared deploys need a persistent remote database.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-auth-token

# Better Auth (required for standalone production deploys)
# The app infers BETTER_AUTH_URL from APP_URL, Netlify, or Vercel when unset.
# Generate via: openssl rand -hex 32
# BETTER_AUTH_SECRET=
# AUTH_DISABLED is false when unset. Use AUTH_DISABLED=true only for local QA.

# AI providers
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Notion integration
# NOTION_API_KEY=

# Notion OAuth (for connecting user accounts — configure via the onboarding wizard)
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# Static bearer access (optional; not browser authentication)
# ACCESS_TOKEN=
