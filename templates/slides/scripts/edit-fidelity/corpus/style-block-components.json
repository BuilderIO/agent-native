{
  "title": "Pricing Proposal — Tailspin Toys",
  "notes": "A second class-styled deck: descendant and :first-child selectors, ::before pseudo accents, a class card containing h3 + hr.accent-bar + p, class-only spans and a CSS variable declared in the stylesheet.",
  "slides": [
    {
      "id": "comp-tiers",
      "layout": "blank",
      "content": "<div class=\"fmd-slide pricing\" style=\"padding: 52px 64px; background: #fffbf5; color: #1c1917; font-family: 'Inter', sans-serif; display: flex; flex-direction: column;\">\n  <style>\n    .pricing { --brand: #ea580c; }\n    .pricing .kicker { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand); }\n    .pricing h2 { font-size: 34px; font-weight: 800; letter-spacing: -0.02em; margin: 8px 0 26px; }\n    .pricing .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }\n    .pricing .box { position: relative; background: #ffffff; border-radius: 12px; padding: 24px 22px 20px; box-shadow: 0 1px 2px rgba(0,0,0,0.06), 0 8px 24px rgba(234, 88, 12, 0.08); }\n    .pricing .box::before { content: \"\"; position: absolute; top: 0; left: 22px; right: 22px; height: 3px; border-radius: 0 0 3px 3px; background: var(--brand); }\n    .pricing .box h3 { font-size: 18px; margin: 0 0 4px; }\n    .pricing .box .price { font-size: 32px; font-weight: 800; letter-spacing: -0.02em; }\n    .pricing .box .price span { font-size: 14px; font-weight: 500; color: #78716c; }\n    .pricing hr.accent-bar { border: none; height: 2px; width: 32px; background: var(--brand); margin: 12px 0; }\n    .pricing .box p { font-size: 14px; line-height: 1.5; color: #57534e; margin: 0; }\n    .pricing .box:first-child { background: #fff7ed; }\n    .pricing .tag { color: var(--brand); font-weight: 700; }\n  </style>\n  <div class=\"kicker\">Proposal</div>\n  <h2>Three ways to start</h2>\n  <div class=\"tiers\">\n    <div class=\"box\"><h3>Starter</h3><div class=\"price\">$4k <span>/ month</span></div><hr class=\"accent-bar\"><p>Up to 20 stores, standard reporting and email support.</p></div>\n    <div class=\"box\"><h3>Growth</h3><div class=\"price\">$9k <span>/ month</span></div><hr class=\"accent-bar\"><p>Unlimited stores, forecasting and a <span class=\"tag\">named</span> success manager.</p></div>\n    <div class=\"box\"><h3>Enterprise</h3><div class=\"price\">Custom</div><hr class=\"accent-bar\"><p>Private deployment, SSO and a 99.9% uptime commitment.</p></div>\n  </div>\n</div>"
    },
    {
      "id": "comp-terms",
      "layout": "blank",
      "content": "<div class=\"fmd-slide terms\" style=\"padding: 56px 72px; background: #fffbf5; color: #1c1917; font-family: 'Inter', sans-serif; display: flex; flex-direction: column; gap: 16px;\">\n  <style>\n    .terms h2 { font-size: 32px; font-weight: 800; margin: 0 0 8px; }\n    .terms .row { display: flex; gap: 18px; align-items: baseline; padding: 12px 0; border-bottom: 1px dashed #e7e5e4; }\n    .terms .row .k { width: 180px; flex-shrink: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #a8a29e; }\n    .terms .row .v { font-size: 18px; }\n    .terms .row .v em { color: #ea580c; font-style: normal; font-weight: 700; }\n  </style>\n  <h2>Commercial terms</h2>\n  <div class=\"row\"><div class=\"k\">Term</div><div class=\"v\">24 months, with a <em>90-day</em> opt-out after the pilot</div></div>\n  <div class=\"row\"><div class=\"k\">Payment</div><div class=\"v\">Annual in advance, net 30</div></div>\n  <div class=\"row\"><div class=\"k\">Price lock</div><div class=\"v\">Rates fixed through <em>December 2028</em></div></div>\n  <div class=\"row\"><div class=\"k\">Pilot</div><div class=\"v\">Six stores for 60 days at no cost</div></div>\n</div>"
    }
  ]
}
