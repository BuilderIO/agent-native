# Add API keys only in your local .env, deployment secrets, or Settings.
# Never commit real API keys, tokens, webhook URLs, signing secrets, or private data.
# GOOGLE_API_KEY=
# GOOGLE_SEARCH_CX=

# Gemini — used for AI image generation in slides
# GEMINI_API_KEY=

# Brandfetch — used for brand logo and color lookups
# BRANDFETCH_CLIENT_ID=

# Logo.dev — alternative logo provider
# LOGO_DEV_TOKEN=
# LOGO_DEV_SECRET_KEY=

# Database — local PGlite by default
# Set to a hosted PostgreSQL URL for shared or production environments.
# DATABASE_URL=

# Better Auth (required for standalone production deploys)
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL is inferred from APP_URL, Netlify, or Vercel when unset.
# AUTH_DISABLED is false when unset. Use AUTH_DISABLED=true only for local QA.
